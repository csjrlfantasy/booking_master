      "name": "1. 用户注册",
      "item": [
        {
          "name": "TC001 - 正常注册",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('状态码为200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('响应码为0', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.code).to.eql(0);",
                  "});",
                  "pm.test('返回userId', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"testuser_new{{$randomInt}}\",\n    \"password\": \"Pass1234\",\n    \"phone\": \"139{{$randomInt}}\",\n    \"email\": \"test{{$randomInt}}@example.com\",\n    \"nickname\": \"测试用户\",\n    \"source\": \"app\"\n}"
            },
            "url": {
