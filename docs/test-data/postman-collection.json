    {
      "name": "4. 安全测试",
      "item": [
        {
          "name": "TC020 - SQL注入攻击",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('SQL注入被防御', function() {",
                  "    var jsonData = pm.response.json();",
                  "    // SQL注入应该被拒绝或返回错误",
                  "    pm.expect(jsonData.code).to.not.eql(0) || pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"admin' OR '1'='1\",\n    \"password\": \"anything\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/user/login",
              "protocol": "http",
              "host": ["localhost:8080"],
              "path": ["api", "user", "login"]
            }
          }
        },
        {
          "name": "TC021 - XSS攻击",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('XSS攻击被过滤', function() {",
                  "    var jsonData = pm.response.json();",
                  "    // 验证返回数据中特殊字符被转义",
                  "    if (jsonData.code === 0) {",
                  "        pm.expect(jsonData.data.nickname || '').to.not.include('<script>');",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"xssuser\",\n    \"password\": \"Pass1234\",\n    \"phone\": \"13900000099\",\n    \"nickname\": \"<script>alert('XSS')</script>\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/user/register",
              "protocol": "http",
              "host": ["localhost:8080"],
              "path": ["api", "user", "register"]
            }
          }
        }
      ]
    },
