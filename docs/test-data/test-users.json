  "registration_test_data": {
    "valid_cases": [
      {
        "username": "newuser001",
        "password": "Pass1234",
        "phone": "13900000001",
        "email": "newuser001@example.com",
        "nickname": "新用户001",
        "source": "app",
        "description": "完整参数注册"
      },
      {
        "username": "newuser002",
        "password": "Pass1234",
        "phone": "13900000002",
        "description": "仅必填参数注册"
      },
      {
        "username": "newuser003",
        "password": "Complex@123",
        "phone": "13900000003",
        "email": "newuser003@example.com",
        "nickname": "复杂密码用户",
        "source": "h5",
        "inviter_id": 1,
        "description": "复杂密码和邀请人注册"
      }
    ],
    "invalid_cases": [
      {
        "username": "testuser001",
        "password": "Pass1234",
        "phone": "13900000011",
        "error_type": "username_exists",
        "expected_code": 100101,
        "description": "用户名已存在"
      },
      {
        "username": "newuser004",
        "password": "Pass1234",
        "phone": "13800000001",
        "error_type": "phone_exists",
        "expected_code": 100104,
        "description": "手机号已存在"
      },
      {
        "username": "newuser005",
        "password": "Pass1234",
        "phone": "13900000005",
        "email": "invalid-email",
        "error_type": "invalid_email_format",
        "expected_code": "invalid",
        "description": "邮箱格式错误"
      },
      {
        "username": "newuser006",
        "password": "",
        "phone": "13900000006",
        "error_type": "empty_password",
        "expected_code": "invalid",
        "description": "密码为空"
      },
      {
        "username": "",
        "password": "Pass1234",
        "phone": "13900000007",
        "error_type": "empty_username",
        "expected_code": "invalid",
        "description": "用户名为空"
      }
    ]
  },
  "login_test_data": {
    "valid_cases": [
      {
        "username": "testuser001",
        "password": "Pass1234",
        "description": "正常登录"
      }
    ],
    "invalid_cases": [
      {
        "username": "nonexistent",
        "password": "Pass1234",
        "error_type": "user_not_found",
        "expected_code": 100100,
        "description": "用户不存在"
      },
      {
        "username": "testuser001",
        "password": "WrongPassword",
        "error_type": "password_error",
        "expected_code": 100103,
        "description": "密码错误"
      },
      {
        "username": "testuser004",
        "password": "Pass1234",
        "error_type": "user_disabled",
        "expected_code": 100102,
        "description": "用户已禁用"
      },
      {
        "username": "testuser003",
        "password": "Pass1234",
        "error_type": "user_locked",
        "expected_code": 100110,
        "description": "用户已锁定"
      }
    ],
    "lockout_test": {
      "username": "testuser001",
      "wrong_password": "WrongPassword",
      "correct_password": "Pass1234",
      "max_attempts": 5,
      "lockout_duration_minutes": 30,
      "test_sequence": [
        {"attempt": 1, "password": "WrongPassword", "expected_result": "fail", "fail_count_after": 1},
        {"attempt": 2, "password": "WrongPassword", "expected_result": "fail", "fail_count_after": 2},
        {"attempt": 3, "password": "WrongPassword", "expected_result": "fail", "fail_count_after": 3},
        {"attempt": 4, "password": "WrongPassword", "expected_result": "fail", "fail_count_after": 4},
        {"attempt": 5, "password": "WrongPassword", "expected_result": "fail", "fail_count_after": 5, "should_lock": false},
        {"attempt": 6, "password": "WrongPassword", "expected_result": "fail", "expected_code": 100110, "should_lock": true}
      ]
    }
  },
  "boundary_test_data": {
    "username_length": {
      "min_length": 3,
      "max_length": 20,
      "test_cases": [
        {"value": "a", "length": 1, "expected": "rejected", "reason": "小于最小长度"},
        {"value": "ab", "length": 2, "expected": "rejected", "reason": "小于最小长度"},
        {"value": "abc", "length": 3, "expected": "accepted", "reason": "等于最小长度"},
        {"value": "abcd", "length": 4, "expected": "accepted", "reason": "大于最小长度"},
        {"value": "abcdefghijklmnopqrst", "length": 20, "expected": "accepted", "reason": "等于最大长度"},
        {"value": "abcdefghijklmnopqrstu", "length": 21, "expected": "rejected", "reason": "大于最大长度"}
      ]
    },
    "password_length": {
      "min_length": 6,
      "max_length": 20,
      "test_cases": [
        {"value": "", "length": 0, "expected": "rejected", "reason": "空密码"},
        {"value": "a", "length": 1, "expected": "rejected", "reason": "小于最小长度"},
        {"value": "Pass12", "length": 6, "expected": "accepted", "reason": "等于最小长度"},
        {"value": "Pass123", "length": 7, "expected": "accepted", "reason": "大于最小长度"},
        {"value": "P@ssw0rd1234567890", "length": 20, "expected": "accepted", "reason": "等于最大长度"}
      ]
    },
    "phone_format": {
      "valid_pattern": "^1[3-9]\\d{9}$",
      "test_cases": [
        {"value": "13800138000", "valid": true, "reason": "正确格式"},
        {"value": "13900000001", "valid": true, "reason": "正确格式"},
        {"value": "1380013800", "valid": false, "reason": "10位"},
        {"value": "138001380001", "valid": false, "reason": "12位"},
        {"value": "12800138000", "valid": false, "reason": "12开头"},
        {"value": "1380013800a", "valid": false, "reason": "含字母"},
        {"value": "138 0013 8000", "valid": false, "reason": "含空格"}
      ]
    },
    "email_format": {
      "test_cases": [
        {"value": "test@example.com", "valid": true, "reason": "标准格式"},
        {"value": "test.user@example.com", "valid": true, "reason": "含点号"},
        {"value": "test_user@example.com", "valid": true, "reason": "含下划线"},
        {"value": "test@example", "valid": false, "reason": "缺少域名"},
        {"value": "test@.com", "valid": false, "reason": "缺少域名主体"},
        {"value": "testexample.com", "valid": false, "reason": "缺少@"},
        {"value": "test@@example.com", "valid": false, "reason": "@重复"}
      ]
    }
  },
  "security_test_data": {
    "sql_injection": [
      {"payload": "admin' OR '1'='1", "field": "username", "target": "login", "description": "认证绕过"},
      {"payload": "' OR '1'='1' --", "field": "username", "target": "login", "description": "注释攻击"},
      {"payload": "1; DROP TABLE user; --", "field": "userId", "target": "getUser", "description": "数据破坏"},
      {"payload": "1' UNION SELECT * FROM user--", "field": "userId", "target": "getUser", "description": "联合查询"},
      {"payload": "test' WAITFOR DELAY '00:00:05'--", "field": "username", "target": "login", "description": "时间盲注"}
    ],
    "xss_attack": [
      {"payload": "<script>alert('XSS')</script>", "field": "nickname", "target": "register", "description": "脚本注入"},
      {"payload": "javascript:alert('XSS')", "field": "email", "target": "register", "description": "JavaScript协议"},
      {"payload": "<img src=x onerror=alert('XSS')>", "field": "nickname", "target": "register", "description": "错误事件"},
      {"payload": "<svg onload=alert('XSS')>", "field": "nickname", "target": "register", "description": "SVG注入"}
    ]
  },
